# CropShift RESILIENCE — example configuration
#
# Copy this file to ".env" and edit the copy. The real ".env" is ignored by Git
# and must never be committed. Every setting below is optional: with no ".env"
# at all, the app starts with the safe defaults shown here.

# --- Run mode ----------------------------------------------------------------
# true  = use only bundled or cached data and make no network requests
# false = retrieve NASA data live when it is not already cached
OFFLINE_DEMO_MODE=false

# --- Optional external AI services (both OFF by default) ---------------------
# The scientific engine never depends on these. Turning one on requires its
# key below as well; a switch without a key stays inactive.
ENABLE_OPENAI=false
ENABLE_MANUS=false

# --- NASA data retrieval -----------------------------------------------------
# Seconds to wait for a NASA API response (greater than 0, at most 300)
NASA_REQUEST_TIMEOUT=30
# Folder for cached NASA responses (relative paths start at the project root)
NASA_CACHE_DIRECTORY=data/cache
# NASA POWER Daily API endpoint for a single point (must be https)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
# Extra attempts after a rate limit, timeout or temporary server error (0 to 6)
NASA_MAX_RETRIES=3
# Hours before a cached NASA response is requested again (720 = 30 days)
NASA_CACHE_TTL_HOURS=720
# Folder of bundled, real NASA responses used for offline demonstrations
NASA_DEMO_DIRECTORY=data/demo
# A dataset is accepted only if every variable has valid values on at least
# this percentage of the requested days (0 to 100)
NASA_MIN_COMPLETENESS_PERCENT=90

# --- Local storage -----------------------------------------------------------
# SQLite file for saved comparisons (relative paths start at the project root)
DATABASE_PATH=data/cropshift.db

# --- Logging -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# --- Future credentials (leave empty until phases A6 / A7) -------------------
# Paid services. Do not fill these in unless you intend to use them.
OPENAI_API_KEY=
MANUS_API_KEY=
